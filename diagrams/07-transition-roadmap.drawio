<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Transition now, transformation later: one risky area first" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=32;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1120" height="52" as="geometry"/></mxCell><mxCell id="c3" value="TRANSITION (now)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=26;fontColor=#134E4A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="730" height="34" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#0D9488;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="136" as="sourcePoint"/><mxPoint x="770" y="136" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="TRANSFORMATION (later)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=26;fontColor=#2E1065;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="90" width="340" height="34" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7C3AED;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="136" as="sourcePoint"/><mxPoint x="1160" y="136" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;NOW&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;Pick one risky area.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;Add the Ledger layer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;and a separate audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;team there.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=25;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="340" height="300" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;NEXT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;Mirror audit roles at&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;every stage. Audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;becomes a career path&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;for new graduates.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=25;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="340" height="300" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;LATER: 10-20 years&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;Common practice.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;More reviewers, fewer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;builders; most checking&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;automated.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:25px&quot;&gt;Author&amp;#x27;s opinion.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#2E1065;strokeWidth=3;align=center;verticalAlign=middle;fontSize=25;fontFamily=Segoe UI;dashed=1;" vertex="1" parent="1"><mxGeometry x="820" y="160" width="340" height="300" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="310" as="sourcePoint"/><mxPoint x="430" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="770" y="310" as="sourcePoint"/><mxPoint x="820" y="310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Nobody audits their own work, at any stage." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=30;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1120" height="44" as="geometry"/></mxCell><mxCell id="c13" value="The 10-20 year view is the author&amp;#x27;s opinion, not a finding." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=24;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="552" width="1120" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>