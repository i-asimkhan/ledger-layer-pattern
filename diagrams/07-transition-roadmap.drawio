<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Transition now, transformation later: one risky area first" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=32;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1120" height="42" as="geometry"/></mxCell><mxCell id="c3" value="TRANSITION (now)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#134E4A;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="730" height="30" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#0D9488;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="138" as="sourcePoint"/><mxPoint x="770" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="TRANSFORMATION (later)" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#2E1065;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="96" width="340" height="30" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#7C3AED;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="138" as="sourcePoint"/><mxPoint x="1160" y="138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;NOW&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Pick one risky area.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Add the Ledger layer&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;and a separate audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;team there.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=23;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="330" height="290" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;NEXT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Mirror audit roles at&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;every stage. Audit&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;becomes a career path&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;for new graduates.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=23;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="435" y="166" width="330" height="290" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;LATER: 10-20 years&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;Common practice. More&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;reviewers, fewer builders;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;most checking automated.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;Author&amp;#x27;s opinion.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#2E1065;strokeWidth=3;align=center;verticalAlign=middle;fontSize=22;fontFamily=Segoe UI;spacing=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="830" y="166" width="330" height="290" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="311.0" as="sourcePoint"/><mxPoint x="435" y="311.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="765" y="311.0" as="sourcePoint"/><mxPoint x="830" y="311.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Nobody audits their own work, at any stage." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=28;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="1120" height="38" as="geometry"/></mxCell><mxCell id="c13" value="The 10-20 year view is the author&amp;#x27;s opinion, not a finding." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="534" width="1120" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>