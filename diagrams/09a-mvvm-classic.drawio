<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Classic MVVM: data binding, and still no memory of why" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=32;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1120" height="42" as="geometry"/></mxCell><mxCell id="c3" value="The View binds to the ViewModel, which calls the Model and is notified of changes.&lt;br&gt;A different pattern from MVC, the same gap: nothing records the reasoning." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1120" height="84" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;View&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="220" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;ViewModel&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="400" y="346" width="240" height="64" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/s