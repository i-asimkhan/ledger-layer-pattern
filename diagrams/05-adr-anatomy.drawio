, decision,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;alternatives,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;consequences&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;spec link, change hash&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#2E1065;strokeWidth=3;align=center;verticalAlign=middle;fontSize=22;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="64.0" y="274" width="341.3333333333333" height="308" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;ATTESTED&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;signed by the builder&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;name and date&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;edited by builder:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;yes or no&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;(no is flagged)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=3;align=center;verticalAlign=middle;fontSize=22;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="429.3333333333333" y="274" width="341.3333333333333" height="308" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;AUDIT&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;by a different person&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;consistency check&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;explain-back note&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;stress test result&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:22px&quot;&gt;status and date&lt;/span&gt;" style="rounded=1;arcSiz