<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Independence grows with risk: one pattern, three sizes" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=32;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1120" height="42" as="geometry"/></mxCell><mxCell id="c3" value="more independence, deeper audit" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#7F1D1D;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="94" width="1120" height="32" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#DC2626;strokeWidth=5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="40" y="140" as="sourcePoint"/><mxPoint x="1160" y="140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;SMALL TEAM&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Internal audit by someone&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;who did not build it&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Independence: technical&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=3;align=center;verticalAlign=middle;fontSize=21;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="344" width="354" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;LARGE ORGANISATION&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;A separate audit function&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;reporting outside delivery&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Independence: technical,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;managerial, financial&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=3;align=center;verticalAlign=middle;fontSize=21;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="423" y="254" width="354" height="260" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;HIGH SENSITIVITY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Add external auditors&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Scope pinned to an&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;exact version of the code&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;Independence: all three,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:21px&quot;&gt;plus outside assurance&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=3;align=center;verticalAlign=middle;fontSize=21;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="806" y="164" width="354" height="350" as="geometry"/></mxCell><mxCell id="c8" value="Independence terms follow IV&amp;amp;V: technical, managerial, financial.&lt;br&gt;Where a team is too small, one auditor may cover several stages." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=18;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="1120" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>