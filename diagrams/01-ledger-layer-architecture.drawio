<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="The Ledger layer creates the evidence. Audit gives it meaning." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=35;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1120" height="52" as="geometry"/></mxCell><mxCell id="c3" value="&lt;span style=&quot;font-size:32px&quot;&gt;&lt;b&gt;4  AUDIT LAYER&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;independent auditors check the record against the work&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;strokeWidth=3;align=center;verticalAlign=middle;fontSize=26;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="1140" height="84" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:32px&quot;&gt;&lt;b&gt;3  GATE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;no signed, audited record, no merge&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#334155;fontColor=#0F172A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=26;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="166" width="1140" height="84" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:32px&quot;&gt;&lt;b&gt;2  ATTEST&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;the builder reviews, edits and signs the record&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;strokeWidth=3;align=center;verticalAlign=middle;fontSize=26;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="260" width="1140" height="84" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="354" width="250" height="52" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;View&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="414" width="250" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;Controller&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="250" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;1  LEDGER LAYER&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;runs beside the app,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;drafts a record for&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;every change&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#2E1065;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="300" y="354" width="270" height="172" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&quot;font-size:30px&quot;&gt;&lt;b&gt;RECORD, in the repo&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;decision, diagram update,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:26px&quot;&gt;spec link, change hash&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=#0D9488;fontColor=#134E4A;strokeWidth=3;align=center;verticalAlign=middle;fontSize=26;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="590" y="354" width="580" height="172" as="geometry"/></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="440" as="sourcePoint"/><mxPoint x="590" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="Your application, any architecture pattern" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="560" height="30" as="geometry"/></mxCell><mxCell id="c13" value="The harder a change is to undo, the deeper the audit." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=26;fontColor=#78350F;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1140" height="34" as="geometry"/></mxCell><mxCell id="c14" value="Ledger means a record of decisions kept with the code. It is not a blockchain." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#111827;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="1140" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>