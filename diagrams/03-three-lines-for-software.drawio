<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Independent audit sits outside the teams that build" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=34;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1120" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;GOVERNING BODY&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;oversight; backs independent audit&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="830" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;FIRST LINE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;Build teams deliver the work&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;and write the records&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="140" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;SECOND LINE&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;Platform, security, risk:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:24px&quot;&gt;set controls, watch