<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Classic MVC: three layers, none of them remembers why" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=34;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1120" height="50" as="geometry"/></mxCell><mxCell id="c3" value="The picture most of us learned: the user interacts with the View, the View sends input&lt;br&gt;to the Controller, the Controller updates the Model, and the Model notifies the View." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=24;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1120" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:26px&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="20" y="262" width="130" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;View&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="180" y="262" width="190" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;Controller&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="180" y="430" width="190" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:28px&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="460" y="430" width="180" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="297" as="sourcePoint"/><mxPoint x="180" y="297" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="interacts" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=20;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="63.5" y="234" width="109" height="28" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="332" as="sourcePoint"/><mxPoint x="275" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="sends input" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="285" y="367" width="130" height="28" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="465" as="sourcePoint"/><mxPoint x="460" y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="updates" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=20;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="371.0" y="429" width="88" height="28" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="550" y="430" as="sourcePoint"/><mxPoint x="370" y="312" as="targetPoint"/><Array as="points"><mxPoint x="550" y="312"/></Array></mxGeometry></mxCell><mxCell id="c15" value="notifies" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="367" width="99" height="28" as="geometry"/></mxCell><mxCell id="c16" value="Nothing in this picture records&lt;br&gt;why a change was made,&lt;br&gt;who signed it,&lt;br&gt;or who checked it." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=28;fontColor=#111827;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="262" width="470" height="238" as="geometry"/></mxCell><mxCell id="c17" value="Same layers, same arrows in the next picture. Watch what gets added." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=24;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1140" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>