<mxfile host="app.diagrams.net"><diagram id="d1" name="Page-1"><mxGraphModel dx="1200" dy="627" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="627" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Classic MVC: three layers, none of them remembers why" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=32;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1120" height="42" as="geometry"/></mxCell><mxCell id="c3" value="The picture most of us learned: the user interacts with the View, the View sends&lt;br&gt;input to the Controller, the Controller updates the Model, the Model notifies the View." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=22;fontColor=#4B5563;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1120" height="84" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-size:22px&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="346" width="110" height="58" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;View&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="280" y="346" width="180" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Controller&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="280" y="460" width="180" height="58" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-size:24px&quot;&gt;&lt;b&gt;Model&lt;/b&gt;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=3;align=center;verticalAlign=middle;fontSize=24;fontFamily=Segoe UI;spacing=14;" vertex="1" parent="1"><mxGeometry x="550" y="460" width="140" height="58" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="375" as="sourcePoint"/><mxPoint x="280" y="375" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="interacts" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontSize=17;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="169.5" y="341" width="91" height="26" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="404" as="sourcePoint"/><mxPoint x="370" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="sends input" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontSize=17;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="382" y="419.0" width="109" height="26" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="489" as="sourcePoint"/><mxPoint x="550" y="489" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="updates" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontSize=15;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="472.0" y="455" width="66" height="26" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#334155;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="460" as="sourcePoint"/><mxPoint x="460" y="386" as="targetPoint"/><Array as="points"><mxPoint x="620" y="386"/></Array></mxGeometry></mxCell><mxCell id="c15" value="notifies" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;labelBackgroundColor=#FFFFFF;align=center;fontSize=17;fontColor=#334155;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="632" y="416.0" width="82" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Nothing in this picture&lt;br&gt;records why a change was&lt;br&gt;made, who signed it, or&lt;br&gt;who checked it." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=24;fontColor=#111827;fontFamily=Segoe UI;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="780" y="346" width="380" height="172" as="geometry"/></mxCell><mxCell id="c17" value="Same layers, same arrows in the next picture. Watch what gets added." style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=20;fontColor=#111827;fontFamily=Segoe UI;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="556" width="1120" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>